{
  "id": "level-1",
  "title": "Verbes irréguliers",
  "description": "Les 50 verbes irréguliers anglais les plus courants : base, prétérit, participe passé",
  "requiredXP": 0,
  "items": [
    { "id": "iv-001", "type": "verb", "base": "be", "preterit": "was/were", "participle": "been", "fr": "être", "example_en": "I have been to London twice.", "example_fr": "Je suis allé à Londres deux fois." },
    { "id": "iv-002", "type": "verb", "base": "have", "preterit": "had", "participle": "had", "fr": "avoir", "example_en": "She had a good idea.", "example_fr": "Elle a eu une bonne idée." },
    { "id": "iv-003", "type": "verb", "base": "do", "preterit": "did", "participle": "done", "fr": "faire", "example_en": "I have done my homework.", "example_fr": "J'ai fait mes devoirs." },
    { "id": "iv-004", "type": "verb", "base": "say", "preterit": "said", "participle": "said", "fr": "dire", "example_en": "He said the truth.", "example_fr": "Il a dit la vérité." },
    { "id": "iv-005", "type": "verb", "base": "go", "preterit": "went", "participle": "gone", "fr": "aller", "example_en": "They went to the beach.", "example_fr": "Ils sont allés à la plage." },
    { "id": "iv-006", "type": "verb", "base": "get", "preterit": "got", "participle": "got/gotten", "fr": "obtenir", "example_en": "I got a present.", "example_fr": "J'ai reçu un cadeau." },
